# M365 Copilot2API Docker 部署环境变量
# 复制为 .env 后填写实际值:  cp .env.example .env

# ===== 必填 =====

# 管理员密码（首次登录强制修改，之后由控制台管理）
M365_ADMIN_PASSWORD=Sky315989021

# Token 加密主密钥 — 强烈建议设置，用于加密 accounts.json 中的 refresh token
# 生成方法: openssl rand -base64 32
M365_MASTER_KEY=

# ===== 可选 =====

# 公开身份策略（仅微软反代渠道需要）
M365_PUBLIC_IDENTITY_POLICY=false

# 代理池（逗号分隔，支持 http/https/socks5）
# M365_PROXY_POOL=socks5://127.0.0.1:1080

# 工具规划模式: router（默认）或 native
# M365_TOOL_PLANNING_MODE=router

# 聊天/图片超时（秒）
# M365_CHAT_TIMEOUT_SECONDS=120
# M365_IMAGE_TIMEOUT_SECONDS=150
