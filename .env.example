# M365 Copilot2API Docker 部署环境变量
# 复制为 .env 后填写实际值:  cp .env.example .env

# ===== 必填 =====

# 管理员密码（首次登录强制修改，之后由控制台管理）
M365_ADMIN_PASSWORD=change_me_to_strong_password

# Token 加密主密钥 — 强烈建议设置，用于加密 accounts.json 中的 refresh token
# 生成方法: openssl rand -base64 32
M365_MASTER_KEY=

# ===== 可选 =====

# 公开身份策略（仅微软反代渠道需要）
M365_PUBLIC_IDENTITY_POLICY=false

# sing-box 订阅（vless/vmess/trojan/ss 节点）。设置后所有出站流量走 sing-box
# 多端口 SOCKS5，账户按哈希固定出口 IP。优先于下面的单代理。
# M365_SINGBOX_SUBSCRIPTION=https://example.com/subscribe?token=xxx
# M365_SINGBOX_BINARY=sing-box
# M365_SINGBOX_CONFIG_DIR=/tmp/sing-box-config
# M365_SINGBOX_LOCAL_PORT=11080

# 健康探测目标（默认探测 substrate.office.com；403/429 判定出口被封并立即 ban 节点）
# M365_PROXY_HEALTH_URL=https://substrate.office.com/

# 所有节点不可用时是否允许直连回退（默认允许；设为 0/false/no 则失败关闭）
# M365_ALLOW_DIRECT_FALLBACK=1

# 单个出站代理（未配置 sing-box 订阅时使用，支持 http/https/socks5）
# M365_OUTBOUND_PROXY=socks5://127.0.0.1:1080

# 工具规划模式: router（默认）或 native
# M365_TOOL_PLANNING_MODE=router

# 聊天/图片超时（秒）
# M365_CHAT_TIMEOUT_SECONDS=600
# M365_IMAGE_TIMEOUT_SECONDS=150

# WebSocket 帧间空闲超时（秒）。长推理/代理停顿导致帧间隔拉长时，
# 设太短会中途断流并截断回复。默认 180
# M365_WS_IDLE_TIMEOUT_SECONDS=180

# WebSocket 连接池（默认关闭）。池化连接忽略请求的 session/conversation
# 参数，多会话并发时可能串号导致 502/空补全，保持关闭即可。
# 仅在确认无多会话并发时开启：
# M365_ENABLE_WS_POOL=1
